{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session-context.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/track-edits.py"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/stop-checklist.py",
        "loop_limit": 1
      }
    ]
  }
}
